        "jsonBody": "{\n  \"filterGroups\": [{\n    \"filters\": [{\n      \"propertyName\": \"churn_segment\",\n      \"operator\": \"EQ\",\n      \"value\": \"churn_risk_mixpanel\"\n    }]\n  }],\n  \"properties\": [\"email\", \"churn_segment\", \"engagement_score\"],\n  \"limit\": 200\n}",
        "options": {}

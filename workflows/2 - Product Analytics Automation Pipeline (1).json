      "name": "HTTP Request1"
    },
    {
      "parameters": {
        "jsCode": "const mixpanelData = items.find(i => i.json.results?.[0]?.$distinct_id !== undefined);\nconst hubspotData = items.find(i => i.json.results?.[0]?.properties !== undefined);\n\nconst mixpanelResults = mixpanelData?.json.results || [];\nconst hubspotResults = hubspotData?.json.results.filter(c => \n  c.properties?.churn_segment === 'churn_risk_mixpanel'\n) || [];\n\nconst activeEmails = new Set(\n  mixpanelResults\n    .map(u => u.$properties?.$email?.toLowerCase().trim())\n    .filter(Boolean)\n);\n\nconst inconsistencies = hubspotResults.filter(contact => {\n  const email = contact.properties?.email?.toLowerCase().trim();\n  return email && activeEmails.has(email);\n});\n\nreturn [{json: {\n  total_active_mixpanel: activeEmails.size,\n  total_churn_hubspot: hubspotResults.length,\n  inconsistencies_count: inconsistencies.length,\n  inconsistent_contacts: inconsistencies.map(c => c.properties?.email),\n  // Debug — 3 premiers emails de chaque source\n  sample_mixpanel_emails: [...activeEmails].slice(0, 3),\n  sample_hubspot_emails: hubspotResults.slice(0, 3).map(c => c.properties?.email)\n}}];\n"
      },
